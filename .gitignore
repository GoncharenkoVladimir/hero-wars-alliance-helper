# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.idea

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# TypeScript compiled artifacts — only .ts/.tsx sources belong in src/.
# (IDE / `tsc` emits these next to the sources; Vite must resolve the .tsx, not the stale .js.)
src/**/*.js
src/**/*.d.ts
!src/vite-env.d.ts

# IDE / editor artifacts
.DS_Store
*.iml

# TypeScript incremental build cache (machine-generated, changes on every build)
*.tsbuildinfo

# misc
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Raw game dump: contains live session/auth tokens. Use the sanitized copy (src/data/game-data.sanitized.json) instead.
src/data/dame-data.json

# Remote game configs: only the ones the app uses are tracked (see scripts/fetch-configs.mjs; `--all` fetches the rest).
src/data/configs/*
!src/data/configs/_index.json
!src/data/configs/hero.json
!src/data/configs/heroFaction.json
!src/data/configs/heroRole.json
!src/data/configs/heroClass.json
!src/data/configs/heroBattleStat.json
!src/data/configs/artifact.json
!src/data/configs/artifactType.json
!src/data/configs/artifactBattleEffect.json
!src/data/configs/itemColor.json
!src/data/configs/patronSkill.json
!src/data/configs/squadHeroSkill.json
!src/data/configs/battleStatHeroClassBonusType.json
